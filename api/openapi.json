{
  "openapi": "3.1.0",
  "info": {
    "title": "Sayaratak API",
    "version": "1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/openapi.json": {
      "get": {
        "operationId": "getOpenapiJson",
        "summary": "This contract, OpenAPI 3.1",
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "openapi": {
                      "type": "string",
                      "const": "3.1.0"
                    }
                  },
                  "required": [
                    "openapi"
                  ],
                  "additionalProperties": {}
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "getMe",
        "summary": "The signed-in account, or null when signed out",
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "user",
                            "dealership",
                            "workshop",
                            "mechanic",
                            "admin"
                          ]
                        },
                        "fullName": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string",
                          "format": "email",
                          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                        },
                        "phone": {
                          "type": "string",
                          "pattern": "^\\+[1-9]\\d{7,14}$"
                        },
                        "avatarUrl": {
                          "type": "string"
                        },
                        "cityId": {
                          "type": "string"
                        },
                        "verifiedPhone": {
                          "type": "boolean"
                        },
                        "verifiedEmail": {
                          "type": "boolean"
                        },
                        "hasPassword": {
                          "type": "boolean"
                        },
                        "banned": {
                          "type": "boolean"
                        },
                        "bannedReason": {
                          "type": "string"
                        },
                        "bannedUntil": {
                          "type": "string"
                        },
                        "createdAt": {
                          "type": "string"
                        },
                        "onboardingDone": {
                          "type": "boolean"
                        },
                        "interests": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "cars",
                              "trucks",
                              "motorcycles",
                              "tuk_tuks",
                              "parts",
                              "workshops",
                              "mechanics"
                            ]
                          }
                        },
                        "chosenPlanId": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "id",
                        "role",
                        "fullName",
                        "verifiedPhone",
                        "verifiedEmail",
                        "hasPassword",
                        "banned",
                        "createdAt",
                        "onboardingDone",
                        "interests"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/site": {
      "get": {
        "operationId": "getSite",
        "summary": "Public site details: contact and languages",
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "contact": {
                      "type": "object",
                      "properties": {
                        "phone": {
                          "type": "string"
                        },
                        "whatsapp": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        },
                        "address": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "phone",
                        "whatsapp",
                        "email",
                        "address"
                      ]
                    },
                    "locales": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "ar",
                          "en"
                        ]
                      }
                    }
                  },
                  "required": [
                    "contact",
                    "locales"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "not_found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "const": "not_found"
                    },
                    "message": {
                      "type": "string"
                    },
                    "fields": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "retryAfter": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sy.session_token"
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
